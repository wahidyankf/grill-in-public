{
  "name": "grill-in-public",
  "version": "1.0.0",
  "description": "Personal interview-preparation workspace maintained by **Wahidyan Kresna Fridayoka**.",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "check:go-vulnerabilities": "go -C apps/badakmini-cli/cmd/badak-mini tool govulncheck -scan module",
    "check:governance": "nx run badakmini-cli:governance",
    "check:harness-parity": "nx run badakmini-cli:capability-parity",
    "check:markdown-links": "nx run badakmini-cli:markdown-links",
    "check:rule-change": "nx run badakmini-cli:rule-change",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "prepare": "husky",
    "run:dummy": "nx run dummy-app:run",
    "test": "npm run test:quick",
    "test:integration": "nx run-many -t test:integration",
    "test:quick": "nx run-many -t test:quick",
    "typecheck": "nx run-many -t typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahidyankf/grill-in-public.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wahidyankf/grill-in-public/issues"
  },
  "homepage": "https://github.com/wahidyankf/grill-in-public#readme",
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "10.0.1",
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.13.3",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-jsdoc": "64.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "nx": "23.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,css,scss,md,mdx,yaml,yml,html}": "prettier --write"
  }
}
