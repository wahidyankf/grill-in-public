{
  "name": "swe-grilling",
  "version": "1.0.0",
  "description": "Personal interview-preparation workspace maintained by **Wahidyan Kresna Fridayoka**.",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "check:governance": "nx run badak-mini:governance",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "prepare": "husky",
    "run:dummy": "nx run dummy-app:run",
    "test": "npm run test:quick",
    "test:integration": "nx run-many -t test:integration",
    "test:quick": "nx run-many -t test:quick",
    "typecheck": "nx run-many -t typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahidyankf/swe-grilling.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wahidyankf/swe-grilling/issues"
  },
  "homepage": "https://github.com/wahidyankf/swe-grilling#readme",
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.13.3",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "nx": "23.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,css,scss,md,mdx,yaml,yml,html}": "prettier --write"
  }
}
